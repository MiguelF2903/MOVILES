<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="General">
        <SwitchPreferenceCompat
            app:key="notifications"
            app:title="Activar Notificaciones"
            app:summary="Recibir recordatorios para registrar gastos"
            app:defaultValue="true" />
        <ListPreference
            app:key="currency"
            app:title="Moneda principal"
            app:entries="@array/currency_entries"
            app:entryValues="@array/currency_values"
            app:defaultValue="EUR"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
    <PreferenceCategory app:title="Apariencia">
        <SwitchPreferenceCompat
            app:key="dark_mode"
            app:title="Modo Oscuro"
            app:summary="Activar o desactivar el tema oscuro"
            app:defaultValue="false" />
    </PreferenceCategory>
</PreferenceScreen>
